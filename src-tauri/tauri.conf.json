{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cutroom",
  "identifier": "app.cutroom.desktop",
  "version": "0.1.0",
  "build": {
    "beforeDevCommand": "echo ready",
    "beforeBuildCommand": "npm run desktop:prepare",
    "frontendDist": "../dist/public",
    "devUrl": "http://127.0.0.1:5050"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": [
      "resources/app/**/*"
    ],
    "macOS": {
      "entitlements": "entitlements.plist",
      "exceptionDomain": null,
      "frameworks": [],
      "providerShortName": null,
      "signingIdentity": "Developer ID Application: SURYA JAGANNATHA PHANI,SWAROOP,MA KALLAKURI (97ZA7QV77G)",
      "minimumSystemVersion": "10.15",
      "hardenedRuntime": true
    },
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": null
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      },
      "deb": {
        "depends": []
      }
    }
  },
  "plugins": {
    "updater": {
      "active": false,
      "dialog": true,
      "pubkey": "",
      "endpoints": [
        "https://releases.cutroom.app/{{target}}/{{arch}}/{{current_version}}"
      ]
    }
  }
}
