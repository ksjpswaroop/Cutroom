# Required for YouTube search (Research page).
# Google Cloud Console: enable "YouTube Data API v3", create an API key.
YOUTUBE_API_KEY=

# Required for AI Insights, grounded Ideas, Script Writer, and Thumbnail Creator.
# Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.7-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# Optional: HTTP port, defaults to 5000.
PORT=5000

# Optional: bind address, defaults to loopback. Do not set 0.0.0.0 without a
# trusted authentication and rate-limiting gateway. Local Settings is not a
# public secret-management endpoint.
HOST=127.0.0.1

# Optional MiniMax BYOK (text MiniMax-M3, image-01, T2A speech, Hailuo H3 video).
# Global host: https://api.minimax.io  China: https://api.minimaxi.com (must match the key).
# MINIMAX_API_KEY=
# MINIMAX_API_HOST=https://api.minimax.io
# CUTROOM_AI_PROVIDER=minimax
# CUTROOM_IMAGE_PROVIDER=minimax

# Optional slides + cinematic voice (your voice only). Never clone Research creators.
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
# CUTROOM_VOICE_CONSENT=0

# Optional cinematic opt-out. MiniMax Hailuo H3 is used when MINIMAX_API_KEY is set
# unless this is 0. Quote-before-run still required. No YouTube upload.
# CUTROOM_VIDEO_ENABLED=1

# Do not set VIMAX_* — Cutroom never spawns ViMax or stores sidecar env.
# Companion folder export is a Settings flag, default Off.

