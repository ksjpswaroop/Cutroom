# Copy to .notary.env (gitignored) or export in your shell, then:
#   set -a; source .notary.env; set +a
#   CUTROOM_NOTARIZE_SKIP_REBUILD=1 npm run desktop:notarize
#
# Apple ID on this Mac defaults to iamk.swaroop@icloud.com in script/notarize-macos.sh

APPLE_ID=iamk.swaroop@icloud.com
APPLE_TEAM_ID=97ZA7QV77G

# Option A — app-specific password from appleid.apple.com
# APPLE_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Option B — App Store Connect API key (.p8 downloaded from
# https://appstoreconnect.apple.com/access/integrations/api )
# APPLE_API_KEY=KEY_ID
# APPLE_API_ISSUER=ISSUER_UUID
# APPLE_API_KEY_PATH=/absolute/path/to/AuthKey_KEYID.p8

# Option C — keychain profile
# NOTARY_PROFILE=cutroom
